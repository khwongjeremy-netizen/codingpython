N_input = input()
N = int(N_input)

for i in range(N):
    code = input()
    
    letters = ""
    num_str = ''
    total_sum = 0
    is_negative = False 
    
    for char in code:
        if "A" <= char <= "Z":
            letters = letters + char
        
        elif char == "-":
            is_negative = True
            
        elif "0" <= char <= "9":
            # Convert only the single digit found
            num_str += char 
        digit_value = int(num_str)
        
        if is_negative:
            total_sum = total_sum - digit_value
            is_negative = False # Reset the negative flag after using it
        else:
            total_sum = total_sum + digit_value

    # Combine the letters and the final sum
    print(letters + str(total_sum))