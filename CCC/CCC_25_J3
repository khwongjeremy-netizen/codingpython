codes_num = int(input())
code_list = []
for i in range(codes_num):
    code = input()
    code_list.append(code)

for cade in code_list:
    caps = ''
    number = 0
    current = ''

    for i in range(len(cade)):
        if cade[i].isupper():
            caps += cade[i]
        if cade[i].isdigit() or cade[i] == '-' and not cade[i].isalpha():
            current += cade[i]
            print("current: " + str(current))
        elif current != '':
            number += int(current)
            current = ''
            print("number: " + str(number))
print(caps + str(number))